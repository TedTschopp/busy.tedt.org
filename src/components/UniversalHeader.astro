    logo: "https://tedt.org/img/home/logo-SCE.webp",
    logoAlt: "Company logo for SCE",
    width: 250,
    height: 98,
  },
  {
    label:
      "Process Manager for Engineering and Build Process at Southern California Edison",
    href: "https://tedt.org/career/#process-manager-for-engineering-and-build-process-at-southern-california-edison",
    logo: "https://tedt.org/img/home/logo-SCE.webp",
    logoAlt: "Company logo for SCE",
    width: 250,
    height: 98,
  },
  {
    label:
      "Senior Solution Architect for SCE.com at Southern California Edison",
    href: "https://tedt.org/career/#senior-solution-architect-for-sce-com-at-southern-california-edison",
    logo: "https://tedt.org/img/home/logo-SCE.webp",
    logoAlt: "Company logo for SCE",
    width: 250,
    height: 98,
  },
  {
    label:
      "Practice Lead - SAP Portal / Web at Southern California Edison",
    href: "https://tedt.org/career/#practice-lead-sap-portal-web-at-southern-california-edison",
    logo: "https://tedt.org/img/home/logo-SCE.webp",
