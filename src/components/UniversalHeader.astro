    logo: "https://tedt.org/img/home/logo-Dohring.webp",
    logoAlt: "Company logo for Dohring",
    width: 1322,
    height: 1150,
    dividerBefore: true,
  },
];

const projectLinks = [
  {
    label: "Corporate Intranet Redesign",
    href: "https://tedt.org/career/#corporate-intranet-redesign",
  },
  {
    label: "Edison.com Redesign - Corporate Website",
    href: "https://tedt.org/career/#edison-com-redesign-corporate-website",
  },
  {
    label: "MyEdison.com - Corporate Portal",
    href: "https://tedt.org/career/#myedison-com-corporate-portal",
  },
  {
    label: "Edison International Portal - Corporate Portal",
    href: "https://tedt.org/career/#edison-international-portal-corporate-portal",
  },
  {
    label: "Edison SmartConnect",
    href: "https://tedt.org/career/#edison-smartconnect",
  },
];

const primaryLinks = [
  { label: "Tools", href: "https://tedt.org/tools/" },
  { label: "Assessments", href: "https://tedt.org/assessments/" },
  { label: "Presentations", href: "https://tedt.org/slides/" },
  { label: "AI Library", href: "https://ai.tedt.org/" },
  { label: "BUSY Apps", href: "/", current: true },
