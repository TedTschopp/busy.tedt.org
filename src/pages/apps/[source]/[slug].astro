---
import Layout from '../../../layouts/Layout.astro';
import Preview from '../../../components/Preview.astro';
import AppCard from '../../../components/AppCard.astro';
import Discussion from '../../../components/Discussion.astro';
import { Code } from 'astro:components';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { apps, repo, sourceLabel, dateLabel } from '../../../lib/apps';
import { ROOT, renderDocumentation, encodePath } from '../../../../scripts/catalog-lib.mjs';
export function getStaticPaths() { return apps.map(app=>({params:{source:app.source,slug:app.slug},props:{app}})); }
const { app } = Astro.props;
const dir = path.join(process.cwd(),'apps',app.source,app.slug);
const readme = app.readme ? renderDocumentation(readFileSync(path.join(dir,app.readme),'utf8'), (href: string) => {
  if (/^(?:https?:|mailto:|#)/i.test(href)) return href;
  const relative = path.posix.normalize(href.replace(/^\.\//,''));
  return app.files.find((f: any)=>f.path===relative)?.url ?? `https://github.com/${app.provenance.repository}/blob/${app.provenance.commit ?? 'main'}/${app.provenance.path}/${encodePath(relative)}`;
}) : null;
const textSources = app.files.filter((f: any)=>!f.generated && f.bytes<=200000 && /\.(py|js|ts|sh|command|json|ya?ml|toml|txt|ini|cfg|md)$/i.test(f.path)).map((f: any)=>({...f,text:readFileSync(path.join(dir,f.path),'utf8'),lang:/\.py$/i.test(f.path)?'python':/\.json$/i.test(f.path)?'json':/\.md$/i.test(f.path)?'markdown':/\.ya?ml$/i.test(f.path)?'yaml':/\.(js|ts)$/i.test(f.path)?'javascript':'text'}));
const related = apps.filter(a=>a.id!==app.id && a.status==='active').map(a=>({app:a,score:a.tags.filter(t=>app.tags.includes(t)).length})).filter(a=>a.score>0).sort((a,b)=>b.score-a.score||a.app.name.localeCompare(b.app.name)).slice(0,3).map(a=>a.app);
const sourceUrl = `https://github.com/${app.provenance.repository}/tree/${app.provenance.commit ?? 'main'}/${app.provenance.path}`;
---
<Layout title={app.name} description={app.description} image={app.socialImage} type="article" structuredData={{'@context':'https://schema.org','@type':'SoftwareApplication',name:app.name,description:app.description,applicationCategory:'UtilitiesApplication',author:{'@type':'Person',name:app.author},url:`https://busy.tedt.org${app.url}`,downloadUrl:`https://busy.tedt.org${app.downloadUrl}`,image:`https://busy.tedt.org${app.stillPreview}`,license:'https://opensource.org/license/mit'}}>
  <div class="content detail" data-download-gate><a href="/">← All Apps</a><header class="page-heading"><div class="metadata"><span class="kind">BUSY App</span><span class:list={['status',app.status]}>{app.status}</span><span>{sourceLabel(app.source)}</span></div><h1 class="detail-heading">{app.name}</h1><p>{app.description}</p><div class="small muted">Updated {dateLabel(app.updatedAt)} · Added {dateLabel(app.createdAt)} · ↓ <span data-download-count={app.id}>{app.downloads}</span> package download starts</div><div class="accent-rule" style="margin-top:1.25rem"></div></header>
  <div class="detail-grid"><div><p class="small">By <a href={`/contributors/${app.authorSlug}/`}>{app.author}</a> · <a href="#rate">▲ {app.rating} · Rate and Discuss</a></p><div class="tags" style="margin-top:1rem">{app.tags.map((tag: string)=><a href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
    {app.status==='archived' && <p class="empty-state small" style="margin-top:1rem">This app is no longer listed in the upstream catalog. The last mirrored version remains available here.</p>}
    <section class="doc-section"><h2>How It Works</h2>{readme ? <div class="rendered-doc" set:html={readme} /> : <div class="rendered-doc"><p>{app.description}</p><p>Download and extract the complete app folder. Keep its files together; some apps include additional modules, assets, or configuration examples.</p>{app.requirements && <><p>Install the app’s declared Python dependencies in a virtual environment:</p><pre><code>python3 -m venv .venv<br />source .venv/bin/activate<br />python -m pip install -r requirements.txt</code></pre></>}<p>Review <code>app.py</code> and any configuration examples for this app’s options, then run it from the extracted folder:</p><pre><code>python3 app.py</code></pre><p>Connect BUSY Bar over USB, or use the connection options supported by this app. See the <a href="https://docs.busy.app/bar/dev/http-api">official HTTP API documentation</a> for device setup.</p></div>}</section>
    {app.requirements && <section class="doc-section"><h2>Declared Dependencies</h2><Code code={app.requirements} lang="text" /></section>}
    <section class="doc-section"><h2>Source Files</h2><p class="small muted">These are the mirrored source bytes. The complete package also includes every asset and supporting file.</p>{textSources.map((file: any)=><details class="source-file" open={file.path==='app.py'}><summary>{file.path}</summary><div class="source-tools"><button type="button" data-copy-source>Copy</button><a href={file.url} download={file.path.split('/').at(-1)} data-download-gated aria-disabled="true" tabindex="-1">Download File</a></div><Code code={file.text} lang={file.lang} theme="github-dark" /></details>)}</section>
    <section class="doc-section"><h2>Source and Provenance</h2><p class="small"><a href={sourceUrl}>View This Version on GitHub →</a>{app.repo && <> · <a href={app.repo}>Author’s Project →</a></>}</p><p class="hash">Source commit: {app.provenance.commit ?? 'See repository history for this local submission'}<br />Content SHA-256: {app.contentHash}</p></section>
  </div><aside class="download-panel"><Preview {app} eager /><div class="download-body"><h2>Download This App</h2><p class="small muted">Complete folder, original source, and supporting files. {(app.zipBytes/1024).toFixed(0)} KB ZIP.</p><label class="trust"><input type="checkbox" data-trust-ack /><span>I reviewed this app and trust its source and instructions.</span></label><a class="button primary" href={app.downloadUrl} download={`${app.slug}.zip`} data-download-gated data-track-download={app.id} aria-disabled="true" tabindex="-1">Download Complete App</a><a class="button secondary" href={sourceUrl}>View on GitHub</a><p class="hash" style="margin-top:1rem">ZIP SHA-256<br />{app.zipSha256}</p><details style="margin-top:1rem"><summary class="small">All {app.files.length} Files</summary><ul class="file-list small">{app.files.map((f: any)=><li><a href={f.url} download={f.path.split('/').at(-1)} data-download-gated aria-disabled="true" tabindex="-1">{f.path}</a><span>{f.bytes.toLocaleString()} B</span></li>)}</ul></details></div></aside></div>
  {related.length>0 && <section class="related"><h2>Related Apps</h2><div class="app-grid">{related.map(app=><AppCard {app} />)}</div></section>}<Discussion appId={app.id} number={app.discussionNumber} /></div>
</Layout>
