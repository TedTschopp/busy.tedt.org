---
import Layout from '../../layouts/Layout.astro';
import { ideas, ideaUrl, dateLabel } from '../../lib/apps';
---
<Layout title="App Ideas" description="Suggest an app for BUSY Bar, support community proposals, and follow ideas from discussion to working software.">
<header class="page-heading content"><span class="eyebrow">The Next Thing on Your Desk</span><h1>App Ideas</h1><p>A useful display starts with a useful idea. Describe what you wish your BUSY Bar could do, support a proposal, or help someone build it.</p><a class="button primary" href={ideaUrl}>Suggest an App</a><div class="accent-rule" style="margin-top:1.5rem"></div></header>
<section class="content" style="padding-bottom:4rem" data-ideas><div class="idea-controls"><label>Search Ideas<input class="idea-search" type="search" data-idea-search placeholder="Title, problem, or contributor…" /></label><label>Status<select data-idea-status><option value="">All statuses</option>{['Proposed','Planned','Building','Shipped','Closed'].map(s=><option value={s}>{s}</option>)}</select></label><label>Sort<select data-idea-sort><option value="newest">Newest</option><option value="support">Most Supported</option></select></label></div>
{ideas.length===0 ? <div class="empty-state"><h2>What Should BUSY Bar Do Next?</h2><p style="margin:1rem 0">There are no app ideas here yet. Start with the problem you want to solve, what the display should show, and any services the app would connect to.</p><a href={ideaUrl}>Record the First Idea on GitHub →</a></div> : <><p class="small muted" aria-live="polite" data-idea-count>{ideas.length} ideas</p><div class="app-grid" data-idea-gallery>{ideas.map((idea: any)=><a class="idea-card" href={`/ideas/${idea.number}/`} data-idea-card data-search={`${idea.title} ${idea.excerpt} ${idea.author}`.toLowerCase()} data-status={idea.status} data-created={idea.createdAt} data-support={idea.support}><span class="eyebrow">{idea.status}</span><h2>{idea.title}</h2><p class="small muted">{idea.excerpt}</p><p class="small" style="margin-top:1rem">▲ {idea.support} · {idea.author} · {dateLabel(idea.createdAt)}</p></a>)}</div><p hidden data-ideas-empty class="empty-state">Nothing matches those filters.</p></>}
<p class="small muted" style="margin-top:2rem">Ideas, votes, and replies are stored in this repository’s GitHub Discussions. A GitHub account is required to submit or participate.</p></section>
<script>const section=document.querySelector('[data-ideas]');if(section){const search=section.querySelector<HTMLInputElement>('[data-idea-search]')!;const status=section.querySelector<HTMLSelectElement>('[data-idea-status]')!;const sort=section.querySelector<HTMLSelectElement>('[data-idea-sort]')!;const cards=[...section.querySelectorAll<HTMLElement>('[data-idea-card]')];function update(){let n=0;for(const c of cards){c.hidden=!(c.dataset.search!.includes(search.value.toLowerCase())&&(!status.value||c.dataset.status===status.value));if(!c.hidden)n++;}cards.sort((a,b)=>sort.value==='support'?Number(b.dataset.support)-Number(a.dataset.support):b.dataset.created!.localeCompare(a.dataset.created!)).forEach(c=>section!.querySelector('[data-idea-gallery]')?.append(c));const count=section!.querySelector('[data-idea-count]');if(count)count.textContent=`${n} ideas`;const empty=section!.querySelector<HTMLElement>('[data-ideas-empty]');if(empty)empty.hidden=n>0;}search.addEventListener('input',update);status.addEventListener('change',update);sort.addEventListener('change',update);}</script>
</Layout>
